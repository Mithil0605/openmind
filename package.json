{
  "name": "openmind-v5",
  "version": "6.1.0",
  "type": "module",
  "description": "Privacy-first, user-controlled memory tools for OpenCode V2 — project-scoped BM25 recall, SSRF-hardened web listening, image/PDF reading with OCR, and optional AES-256-GCM encryption. No session persistence.",
  "main": "index.js",
  "exports": {
    ".": "./index.js"
  },
  "files": [
    "index.js",
    "lib/imgread.py",
    "commands",
    "install.mjs",
    "install.sh",
    "install.ps1",
    "install.cmd",
    "README.md",
    "SETUP.md",
    "ARCHITECTURE.md",
    "LICENSE"
  ],
  "scripts": {
    "lint": "eslint .",
    "test": "npm run lint && node --check index.js",
    "pack:local": "npm pack",
    "setup": "node install.mjs"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "plugin",
    "openmind",
    "memory",
    "privacy",
    "ssrf",
    "image",
    "ocr",
    "pdf",
    "web",
    "listen",
    "scraping",
    "analysis",
    "aes-256-gcm",
    "windows",
    "linux",
    "macos"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mithil0605/openmind.git"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.33",
    "eslint": "^9.39.5"
  }
}
